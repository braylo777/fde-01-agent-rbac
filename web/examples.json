        "client_id": "agent-console",
        "nonce": "n-82f1",
        "now": 1767225600,
        "claims": {
          "iss": "https://login.acme.com",
          "aud": [
            "agent-console",
            "reporting"
          ],
          "sub": "alice",
          "exp": 1767226200,
          "iat": 1767225595,
          "nonce": "n-0000"
        }
      }
    },
