{
  "stage": 1,
  "repo": "fde-01-agent-rbac",
  "title": "Enterprise Identity & Agent RBAC",
  "tagline": "Scoped tool tokens, delegated agent auth, SCIM provisioning and row-level security, so an AI agent can only touch what its human is allowed to touch.",
  "covers": [
    "HS256 scoped JWTs for tool calls: audience, expiry, clock skew, alg=none and tamper refusal",
    "Agent-to-human delegation (RFC 8693 style): scopes narrowed, act claim, TTL capped",
    "Automatic revocation: a SCIM deactivate or delete kills every live agent token for that human; kill by jti or agent id too; verify_token honours the list",
    "SCIM 2.0 create / PATCH / deactivate / delete with group-to-role mapping",
    "Row-level security: deny by default, claim-matched rows, column masking",
    "OIDC ID-token claim checks: iss, aud/azp, exp, iat, nonce"
  ],
  "gaps": [
    "SAML assertion parsing and XML signature checks",
    "RS256/ES256 signatures and JWKS key fetch (HS256 only here)",
    "A real IdP (Okta / Entra) and a real Postgres RLS policy; the logic is the same, the wiring is not"
  ],
  "ops": [
    {
      "op": "issue_token",
      "label": "Issue tool token",
      "help": "Mint a 5-minute token that lets one agent call two CRM tools. Scopes are the allow-list.",
      "input": {
        "now": 1767225600,
        "sub": "agent-sales-7",
        "aud": "crm-tools",
        "scopes": [
          "crm.read",
          "crm.note.write"
        ],
        "secret": "demo-secret-use-a-vault-in-prod-32b",
        "ttl_secs": 300
      }
    },
    {
      "op": "verify_token",
      "label": "Verify before tool call",
      "help": "The tool server checks the token before it runs. Change required_scope to crm.delete to see a refusal, or move now past expiry.",
      "input": {
        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJjcm0tdG9vbHMiLCJleHAiOjE3NjcyMjU5MDAsImlhdCI6MTc2NzIyNTYwMCwiaXNzIjoiZmRlLWFnZW50LXJiYWMiLCJuYmYiOjE3NjcyMjU2MDAsInNjb3BlIjoiY3JtLnJlYWQgY3JtLm5vdGUud3JpdGUiLCJzdWIiOiJhZ2VudC1zYWxlcy03In0.j_i2BVVLKRtjTQHHrbnHums56s6bAykdwzkW4z8ZKYM",
        "secret": "demo-secret-use-a-vault-in-prod-32b",
        "aud": "crm-tools",
        "required_scope": "crm.read",
        "now": 1767225660
      }
    },
    {
      "op": "delegate",
      "label": "Delegate human to agent",
      "help": "Alice's token is exchanged for a narrower agent token. Scopes = requested AND Alice's AND the agent's allow-list. The act claim records the agent.",
      "input": {
        "secret": "demo-secret-use-a-vault-in-prod-32b",
        "now": 1767225610,
        "subject_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhY21lLWlkcCIsImV4cCI6MTc2NzIyOTIwMCwiaWF0IjoxNzY3MjI1NjAwLCJpc3MiOiJmZGUtYWdlbnQtcmJhYyIsIm5iZiI6MTc2NzIyNTYwMCwic2NvcGUiOiJjcm0ucmVhZCBjcm0ud3JpdGUgZW1haWwuc2VuZCIsInN1YiI6ImFsaWNlQGFjbWUuY29tIn0.tjWNMg1YveB0VvKh0lS06cU0LfvTuWXcTuQIuvCrLqA",
        "agent_id": "agent-sales-7",
        "audience": "crm-tools",
        "requested_scopes": [
          "crm.read",
          "email.send",
          "hr.read"
        ],
        "agent_allowed_scopes": [
          "crm.read",
          "hr.read"
        ],
        "ttl_secs": 600
      }
    },
    {
      "op": "scim_apply",
      "label": "SCIM provisioning",
      "help": "The IdP creates a user, adds a group, then deactivates them. Roles are recomputed after each request: a deactivated user has none.",
      "input": {
        "group_roles": {
          "Sales": [
            "crm.read",
            "crm.write"
          ],
          "Finance": [
            "invoice.read"
          ]
        },
        "requests": [
          {
            "method": "POST",
            "body": {
              "userName": "bo@acme.com",
              "displayName": "Bo",
              "groups": [
                {
                  "value": "Sales"
                }
              ]
            }
          },
          {
            "method": "POST",
            "body": {
              "userName": "cy@acme.com",
              "groups": [
                "Finance"
              ]
            }
          },
          {
            "method": "PATCH",
            "id": "u0001",
            "body": {
              "Operations": [
                {
                  "op": "add",
                  "path": "groups",
                  "value": [
                    "Finance"
                  ]
                }
              ]
            }
          },
          {
            "method": "PATCH",
            "id": "u0002",
            "body": {
              "Operations": [
                {
                  "op": "replace",
                  "value": {
                    "active": false
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "op": "rls_filter",
      "label": "Row-level security",
      "help": "A finance agent asks for invoices. It sees only its own department's rows, with the IBAN masked.",
      "input": {
        "table": "invoices",
        "caller": {
          "sub": "agent-fin-2",
          "roles": [
            "finance-agent"
          ],
          "dept": "sales"
        },
        "mask_columns": [
          "iban"
        ],
        "policies": [
          {
            "table": "invoices",
            "role": "finance-agent",
            "where": {
              "column": "dept",
              "equals_claim": "dept"
            }
          },
          {
            "table": "invoices",
            "role": "cfo",
            "unmask": true
          }
        ],
        "rows": [
          {
            "id": 101,
            "dept": "sales",
            "amount": 4200,
            "iban": "DE89 3704 0044 0532 0130 00"
          },
          {
            "id": 102,
            "dept": "ops",
            "amount": 980,
            "iban": "FR14 2004 1010 0505 0001 3M02 606"
          },
          {
            "id": 103,
            "dept": "sales",
            "amount": 15000,
            "iban": "GB29 NWBK 6016 1331 9268 19"
          }
        ]
      }
    },
    {
      "op": "oidc_validate",
      "label": "OIDC claim checks",
      "help": "Claim checks after the signature passes. This token has a wrong nonce (replay) and two audiences without azp.",
      "input": {
